{
  "name": "ghost-notetaker",
  "version": "1.3.0",
  "description": "Tray sticky notes that stay invisible to screen sharing.",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "author": {
    "name": "Sky",
    "url": "https://github.com/skysssup"
  },
  "license": "MIT",
  "keywords": [
    "sticky-notes",
    "electron",
    "screen-sharing",
    "content-protection",
    "tray",
    "markdown",
    "workspaces"
  ],
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ghostnotetaker.app",
    "productName": "Ghost Notetaker",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "build/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ghost Notetaker"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/skysssup/ghost-notetaker.git"
  },
  "homepage": "https://github.com/skysssup/ghost-notetaker",
  "bugs": {
    "url": "https://github.com/skysssup/ghost-notetaker/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
